# ──────────────────────────────────────────────────────────────
# Career OS — Environment Configuration Template (.env.example)
#
# Copy this file to:
#   - BackEnd/.env (for FastAPI backend local development)
#   - Frontend/.env.local (for Next.js frontend local development)
#
# In production:
#   - Set Backend variables in Render Dashboard (Environment tab)
#   - Set Frontend variables in Vercel Dashboard (Environment Variables tab)
#
# NEVER commit real credentials, secret keys, or .env files.
# ──────────────────────────────────────────────────────────────

# ==============================================================
# 1. BACKEND / FASTAPI CONFIGURATION (BackEnd/.env & Render)
# ==============================================================

# Database connection URL
# Local SQLite:    sqlite:///./ah_career.db
# Render with Disk: sqlite:////data/ah_career.db
DATABASE_URL=sqlite:///./ah_career.db

# Alibaba Cloud Model Studio (DashScope) — Qwen AI Runtime
# Obtain an API key from https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BASE_URL=

# Qwen Model Chain (Architecture Phase 2)
# Primary model:
QWEN_MODEL=qwen3.7-plus
# Ordered backup models for eligible availability failures (429/404/5xx):
QWEN_FALLBACK_MODELS=qwen3.6-plus,qwen-plus-2025-07-28,qwen3-vl-235b-a22b-thinking
AI_TIMEOUT_SECONDS=60

# Application Secrets & Security
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins.
# Local: http://localhost:3000,http://127.0.0.1:3000
# Production: https://<your-frontend>.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Admin Ingestion Token (for /api/v1/admin/* protected endpoints)
ADMIN_TOKEN=

# Internal Model Context Protocol (MCP) Server Base URL
# Mounted inside FastAPI; connects via Server-Sent Events (SSE)
MCP_SERVER_BASE_URL=http://127.0.0.1:8000

# Port (set automatically by Render; defaults to 8000 locally)
PORT=8000


# ==============================================================
# 2. FRONTEND / NEXT.JS CONFIGURATION (Frontend/.env.local & Vercel)
# ==============================================================

# Backend API base URL
# Local:      http://localhost:8000/api/v1
# Production: https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mock Mode Switch
# false = connect to live FastAPI backend (recommended)
# true  = run standalone using client-side mock datasets
NEXT_PUBLIC_USE_MOCK=false
