# ──────────────────────────────────────────────────────────────
# Frontend environment variables.
#
# Local development: copy this file to .env.local and adjust values.
# Vercel production:  set these in the Vercel project dashboard.
# ──────────────────────────────────────────────────────────────

# Backend API URL.
# Local:  http://localhost:8000/api/v1
# Prod:   https://<backend>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to "false" to use the real backend; "true" for mock data only.
NEXT_PUBLIC_USE_MOCK=false
