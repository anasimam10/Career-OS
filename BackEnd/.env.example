# Backend Environment Configuration
# Copy to BackEnd/.env and fill in real values.
# NEVER commit the real BackEnd/.env file.

# --- Database ---
DATABASE_URL=sqlite:///./ah_career.db

# --- Qwen / Alibaba Cloud Model Studio (DashScope) ---
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Either the full base URL, or a template containing {WorkspaceId}:
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen3.7-plus
# Ordered backup models for eligible model-availability failures only
# (HTTP 429/404/5xx). Never used when the primary model succeeds.
# Comma-separated; order is preserved. Empty value disables the fallback.
QWEN_FALLBACK_MODELS=qwen3.6-plus,qwen-plus-2025-07-28,qwen3-vl-235b-a22b-thinking
AI_TIMEOUT_SECONDS=60

# --- Application ---
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Admin / ingestion ---
# Bearer token for /api/v1/admin/* endpoints (web ingestion, data quality,
# verification). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty/unset = every admin request is rejected (fail-closed).
ADMIN_TOKEN=
