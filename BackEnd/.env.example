# Backend Environment Configuration
# Copy to BackEnd/.env and fill in real values.
# NEVER commit the real BackEnd/.env file.

# --- Database ---
DATABASE_URL=sqlite:///./ah_career.db

# --- Qwen / Alibaba Cloud Model Studio (DashScope) ---
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Either the full base URL, or a template containing {WorkspaceId}:
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen3.7-plus
AI_TIMEOUT_SECONDS=60

# --- Application ---
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
