*service-account*.json
*credentials*.json
*.pem
*.key
*.p12
*.pfx

# === Python ==================================================
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/

# === Node / Next.js =========================================
Frontend/node_modules/
node_modules/
Frontend/.next/
.next/
Frontend/out/
out/
.vercel/
*.tsbuildinfo

# === Database ================================================
*.db
*.db-journal
*.db-wal
*.db-shm
BackEnd/*.db
ah_career.db

# === IDE / editor ============================================
.vscode/
.idea/
*.swp
*.swo

# === OS ======================================================
.DS_Store
Thumbs.db

